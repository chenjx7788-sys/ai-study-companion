data/
.venv/
__pycache__/
*.pyc
node_modules/
dist/
build/
# 历史构建目录（改名保留时产生，不应进仓库）
dist.*/
dist-*/
data_backup_*/
.env

# 自动备份与运行日志
backend/backups/
*.log

# 根目录开发过程截图（不进公开仓库）
/*.png

# 工作区标记与系统文件
.asc_start_ts.txt
Thumbs.db
.DS_Store

# 浏览器测试快照
.playwright-cli/

# 验证构建与 vite 临时产物
frontend/dist-*/
frontend/vite.config.js.timestamp-*.mjs

# vditor 运行时资源（frontend/scripts/vendor-vditor.mjs 从 node_modules 复制，21.9MB）
# ⚠️ 由 npm 的 predev/prebuild 自动生成，不进仓库；打包时随 dist/ 一起进产物
frontend/public/vditor/

# macOS 打包临时产物（backend/scripts/build_macos.sh 生成）
backend/mascot.png
backend/mascot.icns
backend/mascot.iconset/

# 补丁脚本的落地备份（*.bak-<批次>-<时间戳>，见技能 safe-source-patching）
*.bak-*

# 打包裁剪统计（AIStudyCompanion.spec 每次打包时重写，见技能 ai-study-pack-trim-size）
# 它是「本次打包到底裁掉了什么」的审计凭据，属构建产物，不进仓库
backend/build_trim_stats.json

# 补丁工具的本地备份：_patchlib.py 在同目录生成 `*.patchbak`；
# 抢救/抢救前副本形如 `*.NUL.bak` / `*.preWP16.bak`。
# ⚠️ 它们是**回滚保险**，不是构建产物 —— 只忽略、不删除。
*.patchbak
*.bak
